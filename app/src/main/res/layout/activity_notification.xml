<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".NotificationActivity">

    <androidx.cardview.widget.CardView
        android:id="@+id/notificationDescription"
        android:layout_width="380dp"
        android:layout_height="320dp"
        android:layout_gravity="top|center"
        android:layout_marginTop="20dp"
        app:cardCornerRadius="20dp"
        app:cardElevation="9dp">
        
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/notificationTitle"
            android:text="@string/tvSessionRemainder"
            android:textSize="22sp"
            android:layout_gravity="top|center"
            android:layout_marginTop="7dp"
            android:textStyle="bold"
            android:textColor="#45719B"/>

        <TextView
            android:id="@+id/SessionIDText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="15dp"
            android:layout_marginTop="50dp"
            android:text="@string/tvSessionID"
            android:textColor="#45719B"
            android:textSize="16sp"
            android:textStyle="bold" />

<!--        Kinda have doubts on this part, i am not sure will we implement this-->
        <TextView
            android:id="@+id/notificationTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="50dp"
            android:layout_marginEnd="15dp"
            android:text="Sent: 12:00 AM"
            android:textColor="#45719B"
            android:textSize="16sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/sessionStartTimeText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="15dp"
            android:layout_marginTop="80dp"
            android:text="@string/tvSessionStartTime"
            android:textColor="#45719B"
            android:textSize="16sp"
            android:textStyle="bold" />

        <View
            android:layout_width="360dp"
            android:layout_height="2dp"
            android:background="#45719B"
            android:layout_marginTop="110dp"
            android:layout_marginStart="10dp"/>

        <TextView
            android:id="@+id/notificationMessage"
            android:layout_width="350dp"
            android:layout_height="180dp"
            android:layout_marginTop="120dp"
            android:layout_marginStart="15dp"
            android:text="@string/tvSessionMessage"
            android:textColor="#45719B"
            android:textSize="13sp"
            android:lineSpacingExtra="7dp"
            android:padding="7dp"/>

        <TextView
            android:id="@+id/SessionID"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="100dp"
            android:layout_marginTop="50dp"
            android:text="..."
            android:textColor="#45719B"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/sessionStartTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="161dp"
            android:layout_marginTop="80dp"
            android:text="..."
            android:textColor="#45719B"
            android:textSize="16sp"
            android:textStyle="bold" />


    </androidx.cardview.widget.CardView>

    <TextView
        android:id="@+id/tvBack"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:layout_marginStart="30dp"
        android:text="@string/tvBack"
        android:textSize="18sp"
        android:textColor="#45719B" />
</LinearLayout>