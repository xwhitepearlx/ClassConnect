<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_marginStart="12dp"
    android:layout_marginEnd="12dp"
    android:layout_marginVertical="10dp"
    android:layout_marginHorizontal="10dp"
    app:cardCornerRadius="20dp"
    app:cardElevation="8dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header with icon and date/time -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.google.android.material.imageview.ShapeableImageView
                android:layout_width="45dp"
                android:layout_height="45dp"
                android:id="@+id/image_session"
                android:src="@drawable/session_icon"
                android:tint="#45719B"
                app:shapeAppearanceOverlay="@style/roundedImageViewRounded"/>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toEndOf="@id/image_session"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/SessionIDText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Session ID: "
                        android:textColor="#45719B"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        tools:ignore="HardcodedText"/>

                    <TextView
                        android:id="@+id/SessionID"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1"
                        android:textColor="#45719B"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        tools:ignore="HardcodedText"/>
                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/sessionStartDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2024-12-01"
                    android:textColor="#45719B"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginEnd="8dp"
                    tools:ignore="HardcodedText"/>

                <TextView
                    android:id="@+id/sessionStartTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="10:00 AM"
                    android:textColor="#45719B"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    tools:ignore="HardcodedText"/>
            </LinearLayout>

        </RelativeLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="12dp"
            android:layout_marginBottom="12dp"
            android:background="#E0E0E0"/>

        <!-- Session Details -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Location -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📍 Location: "
                    android:textColor="#666666"
                    android:textSize="14sp"
                    tools:ignore="HardcodedText"/>

                <TextView
                    android:id="@+id/tvSessionLocation"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Room 101"
                    android:textColor="#333333"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    tools:ignore="HardcodedText"/>
            </LinearLayout>

            <!-- Duration -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⏱️ Duration: "
                    android:textColor="#666666"
                    android:textSize="14sp"
                    tools:ignore="HardcodedText"/>

                <TextView
                    android:id="@+id/tvSessionDuration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="60 mins"
                    android:textColor="#333333"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    tools:ignore="HardcodedText"/>
            </LinearLayout>

            <!-- Max Participants -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="👥 Max Participants: "
                    android:textColor="#666666"
                    android:textSize="14sp"
                    tools:ignore="HardcodedText"/>

                <TextView
                    android:id="@+id/tvSessionParticipants"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="30"
                    android:textColor="#333333"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    tools:ignore="HardcodedText"/>
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>